<Page x:Class="TamoPOS.Views.Pages.SalesHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TamoPOS.Views.Pages"
      mc:Ignorable="d"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SalesHistoryPage">

    <Grid>
        <ui:DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Margin="10">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding TicketId}" Width="auto"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="auto"/>
                <DataGridTextColumn Header="Vendedor" Binding="{Binding Employee.FullName}" Width="auto"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="auto"/>
                <DataGridTextColumn Header="Cobrado" Binding="{Binding Paid, StringFormat=C}" Width="auto"/>
                <DataGridTextColumn Header="Cambio" Binding="{Binding ChangeDue, StringFormat=C}" Width="auto"/>
                <DataGridTextColumn Header="Productos" Binding="{Binding ProductsCount}" Width="auto"/>
                
                <!--
                <DataGridTemplateColumn Header="Detalles" Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button 
                                Content="Ir" 
        Command="{Binding DataContext.PrintDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding TicketId}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                -->
            </ui:DataGrid.Columns>
        </ui:DataGrid>

    </Grid>
</Page>
