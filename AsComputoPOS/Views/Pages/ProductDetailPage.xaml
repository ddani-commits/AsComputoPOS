<Page x:Class="TamoPOS.Views.Pages.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TamoPOS.Views.Pages"
      mc:Ignorable="d" 
      xmlns:helpers="clr-namespace:TamoPOS.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      ui:NavigationView.HeaderContent="{Binding CurrentProduct.Name, UpdateSourceTrigger=PropertyChanged}"
      Title="ProductDetailPage">
    <Page.Resources>
        <helpers:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0">

            <Image 
            x:Name="ProductImageB"
            Stretch="UniformToFill"
            Source="{Binding CurrentProduct.ImageData, Converter={StaticResource ByteArrayToImageConverter}, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="Cambiar imagen" Click="Button_Click"></Button>
        </StackPanel>

        <ui:Card Grid.Column="1" Grid.Row="0" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.222"/>
                    <ColumnDefinition Width="4.2"/>
                    <ColumnDefinition Width="5.578"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!--Title-->
                <ui:SymbolIcon Symbol="Box16" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Grid.ColumnSpan="3"/>
                <ui:TextBlock Text="Nombre:" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontTypography="BodyStrong"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Column="5" Grid.Row="0" KeyDown="ProductNameTextBox_KeyDown" Margin="0,0,0,40" Grid.RowSpan="2"></ui:TextBox>
                <ui:Button Grid.Column="6">
                    <ui:SymbolIcon Symbol="Save20" VerticalAlignment="Center"/>
                </ui:Button>
                <!--Categoria-->
                <ui:SymbolIcon Symbol="Tag16" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1" Grid.ColumnSpan="3"/>
                <ui:TextBlock Grid.Column="3" Grid.Row="1" Text="Categoría:" FontTypography="BodyStrong" Margin="10,10,10,10"/>
                <ui:AutoSuggestBox x:Name="CategoryBox" PlaceholderText="{Binding CurrentProduct.Category}" TextChanged="CategoryBox_TextChanged" SuggestionChosen="CategoryBox_SuggestionChosen" Grid.Column="5" Grid.Row="1"/>
                <!--Activo-->
                <ui:SymbolIcon Symbol="PlugDisconnected20" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2" Grid.ColumnSpan="3"/>
                <ui:TextBlock Text="Activar:" Grid.Row="2" Grid.Column="3" FontTypography="BodyStrong" Margin="10,10,10,10"/>
                <ui:ToggleSwitch OnContent="Activado" OffContent="Desactivado" Grid.Column="5" Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Right" IsChecked="{Binding CurrentProduct.IsActive, Mode=TwoWay}" VerticalAlignment="Top"/>
            </Grid>
        </ui:Card>
        <ui:Card Grid.Column="1" Grid.Row="1" Margin="10,10,0,0">
            <StackPanel Orientation="Horizontal">
                <!--Stock-->
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextMore20" Margin="5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock FontTypography="BodyStrong" Text="En stock:" />
                    </StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{Binding QuantityRemaining}" Margin="10,0" HorizontalAlignment="Right"/>
                </StackPanel>
                <!--Vendidos al mes-->
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon VerticalAlignment="Center" Margin="5,0" Symbol="Cart24"/>
                        <ui:TextBlock FontTypography="BodyStrong"  Text="Vendidos este mes:"/>
                    </StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="150" Margin="10,0" HorizontalAlignment="Right"/>
                </StackPanel>
                <!--Precio actual-->
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Money20" Margin="5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Precio actual:"/>
                    </StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{Binding SalePrice, StringFormat={}{0:C2}}" Margin="10,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!--Historial-->
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="10">
            <ui:TextBlock FontTypography="Subtitle" Text="Historial"/>
            <ui:DataGrid CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="False" CanUserResizeRows="False">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha"/>
                    <DataGridTextColumn Header="Total" Width="*"/>
                    <DataGridTextColumn Header="Subtotal" Width="*"/>
                    <DataGridTextColumn Header="Transacción" Width="*"/>
                    <DataGridTextColumn Header="Referencia" Width="*"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding QuantityRemaining}" Width="*"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </StackPanel>
    </Grid>
</Page>
