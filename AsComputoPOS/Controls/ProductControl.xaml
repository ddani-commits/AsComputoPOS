<UserControl x:Class="TamoPOS.Controls.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TamoPOS.Controls"
             xmlns:helpers="clr-namespace:TamoPOS.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <helpers:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </UserControl.Resources>
    <ui:Card Padding="8">
        <StackPanel Orientation="Horizontal" >

            <Image 
            x:Name="ProductImageB"
            Width="90"
            Height="90"
            Stretch="UniformToFill"
            Source="{Binding Product.ImageData, Converter={StaticResource ByteArrayToImageConverter}}" />

            <StackPanel Margin="6, 0">
                <ui:TextBlock 
                    FontTypography="BodyStrong"
                    Text="{Binding Product.Name}" />
                <ui:TextBlock FontTypography="Body" Text="{Binding SalePrice, StringFormat={}{0:C2} }" />
                <ui:TextBlock FontTypography="Caption" Text="{Binding QuantityRemaining, StringFormat={}{0} existencias }" />
                <ui:Button 
                    Appearance="Transparent"
                    Click="Button_Click"
                    Content="Agregar al carrito" />
            </StackPanel>
            <TextBlock Text="{Binding Product.SKU}" />
        </StackPanel>
    </ui:Card>
</UserControl>